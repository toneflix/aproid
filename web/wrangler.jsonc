{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aproid-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/download/*", "/releases/*", "/updates/*", "/api/*"],
  },
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "aproid-releases" }],
  "d1_databases": [
    {
      "binding": "LICENCES",
      "database_name": "aproid-licences",
      "database_id": "dfb12d7a-ce96-41cd-a4d3-0693675e575a",
      "migrations_dir": "migrations",
    },
  ],
  // Secrets, set with `wrangler secret put`: LICENCE_SIGNING_KEY, CODE_SECRET, PADDLE_WEBHOOK_SECRET,
  // PADDLE_API_KEY, SENDPULSE_API_KEY. See docs/LICENCES.md.
  "vars": {
    "PADDLE_CLIENT_TOKEN": "",
    "PADDLE_PRICE_ID": "",
    "PADDLE_SANDBOX": "true",
    "MAIL_FROM": "FlyyLink <hello@toneflix.net>",
  },
  "keep_vars": true,
  "previews": {},
}
