{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flyylink-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/download/*", "/releases/*", "/updates/*", "/api/*"],
  },
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "flyylink-releases" }],
  "d1_databases": [
    {
      "binding": "LICENCES",
      "database_name": "flyylink-licences",
      "database_id": "962f9857-b416-49f2-be08-d1045dff345f",
      "migrations_dir": "migrations",
    },
  ],
  // Secrets, set with `wrangler secret put`: LICENCE_SIGNING_KEY, CODE_SECRET, PADDLE_WEBHOOK_SECRET,
  // PADDLE_API_KEY, SENDPULSE_API_KEY. PADDLE_CLIENT_TOKEN and PADDLE_PRICE_ID are dashboard variables,
  // not listed here, because a var in this file replaces the dashboard's on every deploy. See docs/LICENCES.md.
  "vars": {
    "PADDLE_SANDBOX": "true",
    "MAIL_FROM": "FlyyLink <hello@toneflix.net>",
  },
  "keep_vars": true,
  "previews": {},
}
