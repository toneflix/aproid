<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FlyyLink" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Shown by the system while the app starts, then swapped for Theme.FlyyLink. -->
    <style name="Theme.FlyyLink.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/toneflix_gold</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FlyyLink</item>
    </style>
</resources>
