    <string name="screen_control_label">Aproid computer control</string>
    <string name="screen_control_description">Lets your paired computer tap, swipe and type on this phone while you mirror its screen. It acts only on what you do in the mirror window, reads nothing else on screen, and collects or shares no data.</string>

    <string name="control_disclosure_title">Control your phone from your computer</string>
    <string name="control_disclosure_intro">Aproid uses an accessibility service, "Aproid computer control", so your paired computer\'s mouse and keyboard can work this phone while you mirror its screen.</string>
    <string name="control_disclosure_does">What it does</string>
    <string name="control_disclosure_taps">Taps, swipes and presses Back, Home, Recents and the notification shade where you click in the mirror window</string>
    <string name="control_disclosure_typing">Types into the text field you selected, reading only that field</string>
    <string name="control_disclosure_only">Works only while you mirror to a computer you paired</string>
    <string name="control_disclosure_data">Your data</string>
    <string name="control_disclosure_private">Reads, records and keeps nothing else on your screen</string>
    <string name="control_disclosure_local">Collects and shares no personal data. Clicks and typing go only between your own devices, encrypted</string>
    <string name="control_disclosure_settings">Next, turn on "Aproid computer control" in Accessibility settings. You can turn it off there any time.</string>
    <string name="control_disclosure_accept">Agree and continue</string>
    <string name="control_disclosure_decline">No thanks</string>
