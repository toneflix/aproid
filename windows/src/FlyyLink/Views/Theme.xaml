<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- FlyyLink's colours, the same as the Mac app's Theme. Each has a light and a dark value. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="FlyyLinkAccentBrush" Color="#0086C9" />
            <SolidColorBrush x:Key="FlyyLinkAccentStrongBrush" Color="#005F8F" />
            <SolidColorBrush x:Key="FlyyLinkOnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="FlyyLinkTintBrush" Color="#E3F6FF" />
            <SolidColorBrush x:Key="FlyyLinkOkBrush" Color="#127A4E" />
            <SolidColorBrush x:Key="FlyyLinkOkTintBrush" Color="#E3F5EC" />
            <SolidColorBrush x:Key="FlyyLinkWarnBrush" Color="#9A5B00" />
            <SolidColorBrush x:Key="FlyyLinkPanelBrush" Color="#F8F6F1" />
            <SolidColorBrush x:Key="FlyyLinkCardBrush" Color="#D9FFFFFF" />
            <SolidColorBrush x:Key="FlyyLinkGlassBrush" Color="#66F8F6F1" />
            <SolidColorBrush x:Key="FlyyLinkThumbBrush" Color="#EFEFF3" />
            <SolidColorBrush x:Key="FlyyLinkTrackBrush" Color="#E6E6EB" />
            <SolidColorBrush x:Key="FlyyLinkDeviceBrush" Color="#1C1C20" />
            <SolidColorBrush x:Key="FlyyLinkScreenBrush" Color="#E3F6FF" />
            <SolidColorBrush x:Key="FlyyLinkBorderBrush" Color="#14000000" />
            <SolidColorBrush x:Key="FlyyLinkDashBrush" Color="#2E000000" />
            <SolidColorBrush x:Key="FlyyLinkTextBrush" Color="#1B1B1F" />
            <SolidColorBrush x:Key="FlyyLinkSubBrush" Color="#6B6B73" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0086C9" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E60086C9" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC0086C9" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#005F8F" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#0086C9" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="FlyyLinkAccentBrush" Color="#3CC8FF" />
            <SolidColorBrush x:Key="FlyyLinkAccentStrongBrush" Color="#A6E4FF" />
            <SolidColorBrush x:Key="FlyyLinkOnAccentBrush" Color="#002A3D" />
            <SolidColorBrush x:Key="FlyyLinkTintBrush" Color="#293CC8FF" />
            <SolidColorBrush x:Key="FlyyLinkOkBrush" Color="#4FD39A" />
            <SolidColorBrush x:Key="FlyyLinkOkTintBrush" Color="#244FD39A" />
            <SolidColorBrush x:Key="FlyyLinkWarnBrush" Color="#FFC46B" />
            <SolidColorBrush x:Key="FlyyLinkPanelBrush" Color="#1E1D1A" />
            <SolidColorBrush x:Key="FlyyLinkCardBrush" Color="#D92A2925" />
            <SolidColorBrush x:Key="FlyyLinkGlassBrush" Color="#661E1D1A" />
            <SolidColorBrush x:Key="FlyyLinkThumbBrush" Color="#34343A" />
            <SolidColorBrush x:Key="FlyyLinkTrackBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="FlyyLinkDeviceBrush" Color="#3A3A40" />
            <SolidColorBrush x:Key="FlyyLinkScreenBrush" Color="#383CC8FF" />
            <SolidColorBrush x:Key="FlyyLinkBorderBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="FlyyLinkDashBrush" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="FlyyLinkTextBrush" Color="#F2F2F4" />
            <SolidColorBrush x:Key="FlyyLinkSubBrush" Color="#A3A3AB" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#3CC8FF" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E63CC8FF" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC3CC8FF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#002A3D" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#A6E4FF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#3CC8FF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- The Toneflix gold behind the paired phone. -->
    <LinearGradientBrush x:Key="FlyyLinkGoldBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F6C101" />
        <GradientStop Offset="1" Color="#BB8C01" />
    </LinearGradientBrush>

    <CornerRadius x:Key="FlyyLinkRadius">14</CornerRadius>

    <!-- The rounded card every section sits on. -->
    <Style x:Key="FlyyLinkCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FlyyLinkCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource FlyyLinkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource FlyyLinkRadius}" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="FlyyLinkTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource FlyyLinkTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="FlyyLinkBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource FlyyLinkSubBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FlyyLinkCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource FlyyLinkSubBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="FlyyLinkSectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource FlyyLinkSubBrush}" />
        <Setter Property="CharacterSpacing" Value="40" />
    </Style>

    <!-- Full-width rounded buttons for pairing: filled when prominent. -->
    <Style x:Key="FlyyLinkPillButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="FlyyLinkPillAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A card-like button for the action tiles and Recent rows. -->
    <Style x:Key="FlyyLinkTileButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource FlyyLinkCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource FlyyLinkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource FlyyLinkRadius}" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="FlyyLinkPlainButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
</ResourceDictionary>
