<Window
    x:Class="FlyyLink.Views.MessagesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:FlyyLink.Views"
    xmlns:model="using:FlyyLink.Model"
    Title="Messages">

    <Grid Background="{ThemeResource FlyyLinkGlassBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Conversations -->
        <Grid Padding="12,14,8,12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Padding="4,0,0,0">
                <TextBlock Text="Messages" Style="{StaticResource FlyyLinkTitle}" FontSize="20" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                    <Button Style="{StaticResource FlyyLinkPlainButton}" Padding="8" Click="Dial_Click" IsEnabled="{x:Bind Store.HasPhone, Mode=OneWay}" ToolTipService.ToolTip="Call a number from your phone" AutomationProperties.Name="Call">
                        <views:LucideIcon Icon="Phone" Size="16" Foreground="{ThemeResource FlyyLinkAccentBrush}" />
                    </Button>
                    <Button Style="{StaticResource FlyyLinkPlainButton}" Padding="8" Click="Compose_Click" IsEnabled="{x:Bind Store.HasPhone, Mode=OneWay}" ToolTipService.ToolTip="New message" AutomationProperties.Name="New message">
                        <views:LucideIcon Icon="SquarePen" Size="16" Foreground="{ThemeResource FlyyLinkAccentBrush}" />
                    </Button>
                </StackPanel>
            </Grid>

            <TextBox Grid.Row="1" PlaceholderText="Search" Text="{x:Bind Store.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CornerRadius="10" />

            <ListView x:Name="ConversationList" Grid.Row="2" ItemsSource="{x:Bind Store.Shown, Mode=OneWay}" SelectionMode="Single" SelectionChanged="ConversationList_SelectionChanged" Padding="0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:Conversation">
                        <Grid ColumnSpacing="10" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <views:Avatar NameText="{x:Bind Title}" Diameter="40" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="{x:Bind views:MessagesWindow.Weight(IsUnread)}" Foreground="{ThemeResource FlyyLinkTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind When}" Style="{StaticResource FlyyLinkCaption}" />
                                </Grid>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Preview}" Style="{StaticResource FlyyLinkCaption}" FontSize="12" MaxLines="2" TextWrapping="Wrap" />
                                    <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{ThemeResource FlyyLinkAccentBrush}" Visibility="{x:Bind IsUnread}" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="2" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind Store.IsEmpty, Mode=OneWay}">
                <ProgressRing IsActive="{x:Bind Store.IsLoadingList, Mode=OneWay}" Visibility="{x:Bind Store.IsLoadingList, Mode=OneWay}" Width="20" Height="20" />
                <TextBlock Text="{x:Bind Store.EmptyText, Mode=OneWay}" Style="{StaticResource FlyyLinkBody}" TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- The open conversation -->
        <Border Grid.Column="1" Background="{ThemeResource FlyyLinkCardBrush}" BorderBrush="{ThemeResource FlyyLinkBorderBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind views:MessagesWindow.Hidden(Store.HasSelection), Mode=OneWay}">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{ThemeResource FlyyLinkTintBrush}" HorizontalAlignment="Center">
                        <views:LucideIcon Icon="MessagesSquare" Size="28" Foreground="{ThemeResource FlyyLinkAccentBrush}" />
                    </Border>
                    <TextBlock Text="Pick a conversation" Style="{StaticResource FlyyLinkTitle}" HorizontalAlignment="Center" />
                </StackPanel>

                <Grid Visibility="{x:Bind Store.HasSelection, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Padding="18,12" ColumnSpacing="12" BorderBrush="{ThemeResource FlyyLinkBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <views:Avatar NameText="{x:Bind SelectedTitle(Store.Selected), Mode=OneWay}" Diameter="36" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind SelectedTitle(Store.Selected), Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource FlyyLinkTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind SelectedNumbers(Store.Selected), Mode=OneWay}" Style="{StaticResource FlyyLinkCaption}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource FlyyLinkPlainButton}" Padding="8" Click="CallSelected_Click" ToolTipService.ToolTip="Call from your phone" AutomationProperties.Name="Call">
                            <views:LucideIcon Icon="Phone" Size="16" Foreground="{ThemeResource FlyyLinkAccentBrush}" />
                        </Button>
                    </Grid>

                    <ListView x:Name="ThreadList" Grid.Row="1" ItemsSource="{x:Bind Store.Thread, Mode=OneWay}" SelectionMode="None" Padding="12,8">
                        <ListView.Header>
                            <StackPanel HorizontalAlignment="Center" Padding="0,6">
                                <ProgressRing IsActive="{x:Bind Store.IsLoadingThread, Mode=OneWay}" Visibility="{x:Bind Store.IsLoadingThread, Mode=OneWay}" Width="18" Height="18" />
                                <HyperlinkButton Content="Load earlier messages" FontSize="11" Click="LoadEarlier_Click" Visibility="{x:Bind views:MessagesWindow.Hidden(Store.IsLoadingThread), Mode=OneWay}" />
                            </StackPanel>
                        </ListView.Header>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="0,2" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="model:MessageBubble">
                                <StackPanel HorizontalAlignment="{x:Bind views:MessagesWindow.Side(IsMine)}" MaxWidth="420" Spacing="2" Opacity="{x:Bind views:MessagesWindow.Fade(Pending)}">
                                    <Border CornerRadius="16" Padding="12,8" Background="{x:Bind views:MessagesWindow.BubbleBrush(IsMine)}">
                                        <StackPanel Spacing="6">
                                            <Image Source="{x:Bind views:MessagesWindow.Picture(Picture)}" Visibility="{x:Bind HasPicture}" MaxHeight="220" Stretch="Uniform" />
                                            <TextBlock Text="{x:Bind Body}" Visibility="{x:Bind HasBody}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="13" Foreground="{x:Bind views:MessagesWindow.BubbleText(IsMine)}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{x:Bind Caption}" FontSize="10" Foreground="{ThemeResource FlyyLinkSubBrush}" HorizontalAlignment="{x:Bind views:MessagesWindow.Side(IsMine)}" Margin="6,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Grid.Row="2" Padding="14,10,14,14" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="Reply" PlaceholderText="Text message" AcceptsReturn="False" TextWrapping="Wrap" MaxHeight="120" CornerRadius="18" Padding="14,8" KeyDown="Reply_KeyDown" IsEnabled="{x:Bind Store.HasPhone, Mode=OneWay}" />
                        <Button Grid.Column="1" Width="38" Height="38" CornerRadius="19" Padding="0" Style="{StaticResource AccentButtonStyle}" Click="Send_Click" IsEnabled="{x:Bind Store.HasPhone, Mode=OneWay}" VerticalAlignment="Bottom" ToolTipService.ToolTip="Send" AutomationProperties.Name="Send">
                            <views:LucideIcon Icon="ArrowUp" Size="16" Foreground="{ThemeResource FlyyLinkOnAccentBrush}" />
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
