<Window
    x:Class="Aproid.Views.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Aproid.Views"
    xmlns:model="using:Aproid.Model"
    Title="Aproid">

    <Grid x:Name="Root" Background="{ThemeResource AproidGlassBrush}">
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel x:Name="Sections" Width="{StaticResource AproidPanelWidth}" Padding="14" Spacing="12">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <!-- Header -->
                <Grid Padding="2,0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <views:AppGlyph VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Aproid" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Foreground="{ThemeResource AproidTextBrush}" />
                    <Button Grid.Column="2" Style="{StaticResource AproidPlainButton}" ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings">
                        <views:LucideIcon Icon="Settings" Size="15" Foreground="{ThemeResource AproidSubBrush}" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="SettingsMenu" Placement="BottomEdgeAlignedRight" Opening="SettingsMenu_Opening" />
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!-- Error -->
                <Border Style="{StaticResource AproidCard}" Padding="10" Visibility="{x:Bind Model.HasError, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <views:LucideIcon Icon="TriangleAlert" Size="13" Foreground="{ThemeResource AproidWarnBrush}" />
                        <TextBlock Text="{x:Bind Model.Error, Mode=OneWay}" Style="{StaticResource AproidCaption}" TextWrapping="Wrap" MaxWidth="290" />
                    </StackPanel>
                </Border>

                <!-- No phone yet -->
                <Border Style="{StaticResource AproidCard}" Padding="18" Visibility="{x:Bind Model.ShowsSearching, Mode=OneWay}">
                    <StackPanel Spacing="14" Padding="0,10">
                        <Grid Height="96" HorizontalAlignment="Center">
                            <Ellipse x:Name="PulseOne" Width="64" Height="64" StrokeThickness="1.5" Stroke="{ThemeResource AproidAccentBrush}" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="PulseOneScale" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="PulseTwo" Width="64" Height="64" StrokeThickness="1.5" Stroke="{ThemeResource AproidAccentBrush}" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="PulseTwoScale" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Width="64" Height="64" Fill="{ThemeResource AproidTintBrush}" />
                            <views:PhoneArt ArtWidth="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Spacing="5">
                            <TextBlock Text="{x:Bind SearchingTitle(Model.HasOthers), Mode=OneWay}" Style="{StaticResource AproidTitle}" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind SearchingHint(Model.HasOthers), Mode=OneWay}" Style="{StaticResource AproidBody}" TextAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Pairing -->
                <Border Style="{StaticResource AproidCard}" Padding="20" Visibility="{x:Bind Model.ShowsPairing, Mode=OneWay}">
                    <StackPanel Spacing="18">
                        <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <views:PhoneArt ArtWidth="36" />
                            <StackPanel x:Name="SignalDots" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <Ellipse x:Name="DotOne" Width="6" Height="6" Fill="{ThemeResource AproidAccentBrush}" />
                                <Ellipse x:Name="DotTwo" Width="6" Height="6" Fill="{ThemeResource AproidAccentBrush}" Opacity="0.3" />
                                <Ellipse x:Name="DotThree" Width="6" Height="6" Fill="{ThemeResource AproidAccentBrush}" Opacity="0.3" />
                            </StackPanel>
                            <views:LaptopArt />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind Model.Focused.PairingTitle, Mode=OneWay, FallbackValue=''}" Style="{StaticResource AproidTitle}" FontSize="18" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                            <TextBlock Text="{x:Bind Model.Focused.PairingHint, Mode=OneWay, FallbackValue=''}" Style="{StaticResource AproidBody}" TextAlignment="Center" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{x:Bind Model.Focused.CodeCharacters, Mode=OneWay}" HorizontalAlignment="Center" AutomationProperties.Name="Verification code">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Width="28" Height="40" CornerRadius="8" Background="{ThemeResource AproidTintBrush}">
                                        <TextBlock Text="{x:Bind}" FontFamily="Consolas" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource AproidAccentStrongBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ProgressRing IsActive="{x:Bind Model.Focused.IsOurRequest, Mode=OneWay, FallbackValue=False}" Visibility="{x:Bind Model.Focused.IsOurRequest, Mode=OneWay, FallbackValue=Collapsed}" Width="20" Height="20" />

                        <Grid ColumnSpacing="8" Visibility="{x:Bind Model.Focused.IsTheirRequest, Mode=OneWay, FallbackValue=Collapsed}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Not now" Style="{StaticResource AproidPillButton}" Click="Reject_Click" />
                            <Button Grid.Column="1" Content="Pair" Style="{StaticResource AproidPillAccentButton}" Click="Accept_Click" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <views:LucideIcon Icon="Lock" Size="11" Foreground="{ThemeResource AproidSubBrush}" />
                            <TextBlock Text="End-to-end encrypted on your local network" FontSize="10.5" Foreground="{ThemeResource AproidSubBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- The paired phone -->
                <StackPanel Spacing="12" Visibility="{x:Bind Model.ShowsPhone, Mode=OneWay}">
                    <!-- In the carousel the next phone's card peeks out at the panel's edge. -->
                    <Grid ColumnSpacing="8" Margin="{x:Bind CarouselBleed(Model.ShowsCarousel), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Hero" Background="{StaticResource AproidGoldBrush}" CornerRadius="{StaticResource AproidRadius}" Padding="16" RequestedTheme="Light">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="HeroShift" />
                        </Border.RenderTransform>
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <views:PhoneArt ArtWidth="40" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                <Button x:Name="PhoneName" Style="{StaticResource AproidPlainButton}" Padding="0" IsEnabled="{x:Bind Model.HasOtherPhones, Mode=OneWay}" ToolTipService.ToolTip="Switch to another phone">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{x:Bind Model.Focused.Name, Mode=OneWay, FallbackValue=''}" FontSize="16" FontWeight="Bold" Foreground="#1B1B1F" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                        <views:LucideIcon Icon="ChevronDown" Size="11" Foreground="#5A4A10" VerticalAlignment="Center" Visibility="{x:Bind Model.HasOtherPhones, Mode=OneWay}" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <MenuFlyout x:Name="PhoneMenu" Opening="PhoneMenu_Opening" />
                                    </Button.Flyout>
                                </Button>
                                <Border Background="{ThemeResource AproidOkTintBrush}" CornerRadius="10" Padding="9,4" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="7" Height="7" Fill="{ThemeResource AproidOkBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Connected over Wi-Fi" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AproidOkBrush}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{x:Bind Model.PhoneSummary, Mode=OneWay}" FontSize="11" Foreground="#4A4030" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <views:BatteryRing Grid.Column="2" VerticalAlignment="Center" Charge="{x:Bind BatteryCharge(Model.Focused), Mode=OneWay}" IsCharging="{x:Bind Model.Focused.IsCharging, Mode=OneWay, FallbackValue=False}" />
                        </Grid>
                    </Border>
                    <Button Grid.Column="1" Width="22" Padding="0" VerticalAlignment="Stretch" Style="{StaticResource AproidPlainButton}" Visibility="{x:Bind Model.ShowsCarousel, Mode=OneWay}"
                            Click="NextPhone_Click" ToolTipService.ToolTip="{x:Bind NextTitle(Model.NextPhone), Mode=OneWay}" AutomationProperties.Name="{x:Bind NextTitle(Model.NextPhone), Mode=OneWay}">
                        <Border Width="22" VerticalAlignment="Stretch" Background="{StaticResource AproidGoldBrush}" CornerRadius="14,0,0,14" Opacity="0.75" />
                    </Button>
                    </Grid>

                    <!-- Find the phone: where it is, after asking it to ring -->
                    <Border Style="{StaticResource AproidCard}" Padding="12" Visibility="{x:Bind IsFinding(Model.Finding, Model.Focused), Mode=OneWay}">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <views:LucideIcon Icon="MapPin" Size="13" Foreground="{ThemeResource AproidAccentBrush}" />
                                    <TextBlock Text="{x:Bind FindTitle(Model.Focused), Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AproidAccentBrush}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                </StackPanel>
                                <Button Style="{StaticResource AproidPlainButton}" HorizontalAlignment="Right" Padding="2" Click="StopFinding_Click" ToolTipService.ToolTip="Hide the map" AutomationProperties.Name="Hide the map">
                                    <views:LucideIcon Icon="CircleX" Size="14" Foreground="{ThemeResource AproidSubBrush}" />
                                </Button>
                            </Grid>
                            <Grid Height="170" CornerRadius="10" Background="{ThemeResource AproidThumbBrush}">
                                <WebView2 x:Name="Map" Visibility="{x:Bind HasLocation(Model.Found), Mode=OneWay}" />
                                <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind NoLocation(Model.Found), Mode=OneWay}">
                                    <ProgressRing IsActive="{x:Bind IsLocating(Model.Found), Mode=OneWay}" Width="18" Height="18" />
                                    <TextBlock Text="Ringing and asking where it is…" Style="{StaticResource AproidCaption}" />
                                </StackPanel>
                            </Grid>
                            <Grid Visibility="{x:Bind HasLocation(Model.Found), Mode=OneWay}">
                                <TextBlock Text="{x:Bind LocationDetail(Model.Found), Mode=OneWay}" Style="{StaticResource AproidCaption}" VerticalAlignment="Center" />
                                <HyperlinkButton HorizontalAlignment="Right" Padding="4,0" FontSize="11" FontWeight="SemiBold" Click="OpenMap_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Open map" />
                                        <views:LucideIcon Icon="ExternalLink" Size="11" Foreground="{ThemeResource AproidAccentBrush}" />
                                    </StackPanel>
                                </HyperlinkButton>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- What the phone is playing -->
                    <Border Style="{StaticResource AproidCard}" Padding="12" Visibility="{x:Bind HasMedia(Model.Focused), Mode=OneWay}">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="46" Height="46" CornerRadius="9" Background="{ThemeResource AproidTintBrush}">
                                    <views:LucideIcon Icon="Music" Size="18" Foreground="{ThemeResource AproidAccentBrush}" />
                                    <Image Source="{x:Bind Artwork(Model.Focused), Mode=OneWay}" Stretch="UniformToFill" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind MediaTitle(Model.Focused), Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AproidTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind MediaSubtitle(Model.Focused), Mode=OneWay}" Style="{StaticResource AproidCaption}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <Button Style="{StaticResource AproidPlainButton}" Width="32" Height="32" CornerRadius="16" Padding="0" Tag="Previous" Click="Media_Click" IsEnabled="{x:Bind CanGoPrevious(Model.Focused), Mode=OneWay}" ToolTipService.ToolTip="Previous" AutomationProperties.Name="Previous">
                                        <views:LucideIcon Icon="SkipBack" Size="13" Foreground="{ThemeResource AproidTextBrush}" />
                                    </Button>
                                    <Button Style="{StaticResource AproidPlainButton}" Width="36" Height="36" CornerRadius="18" Padding="0" Tag="PlayPause" Click="Media_Click" ToolTipService.ToolTip="Play or pause" AutomationProperties.Name="Play or pause">
                                        <views:LucideIcon Icon="{x:Bind PlayIcon(Model.Focused), Mode=OneWay}" Size="17" Foreground="{ThemeResource AproidTextBrush}" />
                                    </Button>
                                    <Button Style="{StaticResource AproidPlainButton}" Width="32" Height="32" CornerRadius="16" Padding="0" Tag="Next" Click="Media_Click" IsEnabled="{x:Bind CanGoNext(Model.Focused), Mode=OneWay}" ToolTipService.ToolTip="Next" AutomationProperties.Name="Next">
                                        <views:LucideIcon Icon="SkipForward" Size="13" Foreground="{ThemeResource AproidTextBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="MediaTrack" Height="10" Background="Transparent" PointerPressed="MediaTrack_PointerPressed" Visibility="{x:Bind HasLength(Model.Focused), Mode=OneWay}">
                                <ProgressBar x:Name="MediaProgress" Maximum="1" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <views:ActionTile Icon="Volume2" Title="Ring phone" Subtitle="Full volume" Click="Ring_Click" />
                        <views:ActionTile Grid.Column="1" Icon="FileUp" Title="Send file" Subtitle="To Downloads" Click="SendFiles_Click" />
                        <views:ActionTile Grid.Row="1" Icon="Clipboard" Title="Clipboard" Subtitle="{x:Bind Model.ClipboardSubtitle, Mode=OneWay}" Click="Clipboard_Click" />
                        <views:ActionTile Grid.Row="1" Grid.Column="1" Icon="{x:Bind NotificationsIcon(Model.MirrorsNotifications), Mode=OneWay}" Title="Notifications" Subtitle="{x:Bind Model.NotificationsSubtitle, Mode=OneWay}" IsOn="{x:Bind Model.MirrorsNotifications, Mode=OneWay}" Click="Notifications_Click" />
                        <views:ActionTile Grid.Row="2" Icon="MessageSquare" Title="Messages" Subtitle="{x:Bind Model.MessagesSubtitle, Mode=OneWay}" Click="Messages_Click" />
                        <views:ActionTile Grid.Row="2" Grid.Column="1" Icon="Phone" Title="Call" Subtitle="From your phone" Click="Call_Click" />
                        <views:ActionTile Grid.Row="3" Icon="Cast" Title="Mirror" Subtitle="See &amp; use your phone" Click="Mirror_Click" />
                        <views:ActionTile Grid.Row="3" Grid.Column="1" Icon="Images" Title="Photos" Subtitle="Browse &amp; download" Click="Photos_Click" />
                    </Grid>

                    <!-- Drop files to send them -->
                    <Grid x:Name="DropZone" Height="64" AllowDrop="True" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave" Drop="DropZone_Drop" Background="Transparent">
                        <Rectangle x:Name="DropOutline" RadiusX="14" RadiusY="14" StrokeThickness="1.5" StrokeDashArray="4,3" Stroke="{ThemeResource AproidDashBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <views:LucideIcon Icon="Download" Size="14" Foreground="{ThemeResource AproidSubBrush}" />
                            <TextBlock x:Name="DropLabel" Text="Drop files or links here to send them" FontSize="12" Foreground="{ThemeResource AproidSubBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Other devices -->
                <Border Style="{StaticResource AproidCard}" Padding="12" Visibility="{x:Bind Model.HasOthers, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="ALSO NEARBY" Style="{StaticResource AproidSectionHeader}" />
                        <ItemsControl ItemsSource="{x:Bind Model.Others, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="model:DeviceState">
                                    <Grid ColumnSpacing="10" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="8" Background="{ThemeResource AproidTintBrush}">
                                            <views:LucideIcon Icon="Smartphone" Size="14" Foreground="{ThemeResource AproidAccentBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AproidTextBrush}" />
                                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource AproidCaption}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="{x:Bind views:PanelWindow.RowAction(PairState)}" Tag="{x:Bind Id}" Click="RowAction_Click" VerticalAlignment="Center" CornerRadius="8" Padding="12,4" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Recent -->
                <Border Style="{StaticResource AproidCard}" Padding="12" Visibility="{x:Bind Model.HasRecent, Mode=OneWay}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="RECENT" Style="{StaticResource AproidSectionHeader}" VerticalAlignment="Center" />
                            <HyperlinkButton Content="Clear" HorizontalAlignment="Right" Padding="4,0" FontSize="11" Click="ClearRecent_Click" />
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind Model.Recent}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="model:Activity">
                                    <Button Style="{StaticResource AproidPlainButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="4,6" Tag="{x:Bind}" Click="Activity_Click">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="8" Background="{ThemeResource AproidThumbBrush}" VerticalAlignment="Top">
                                                <views:LucideIcon Icon="{x:Bind Icon}" Size="14" Foreground="{ThemeResource AproidAccentBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AproidTextBrush}" />
                                                <TextBlock Text="{x:Bind Caption}" Style="{StaticResource AproidCaption}" />
                                                <ProgressBar Value="{x:Bind ProgressPercent}" Visibility="{x:Bind ShowsProgress}" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Notifications unavailable -->
                <Border Style="{StaticResource AproidCard}" Padding="10" Visibility="{x:Bind NotificationsMissing}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <views:LucideIcon Icon="BellOff" Size="13" Foreground="{ThemeResource AproidWarnBrush}" />
                        <TextBlock Text="Windows notifications are turned off for Aproid." Style="{StaticResource AproidCaption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Footer -->
                <Grid Padding="4,0">
                    <TextBlock Text="{x:Bind Model.ThisComputer}" Style="{StaticResource AproidCaption}" VerticalAlignment="Center" MaxWidth="250" HorizontalAlignment="Left" />
                    <HyperlinkButton Content="Quit" HorizontalAlignment="Right" Padding="4,0" FontSize="11" Click="Quit_Click" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
