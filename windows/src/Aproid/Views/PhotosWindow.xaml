<Window
    x:Class="Aproid.Views.PhotosWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Aproid.Views"
    xmlns:model="using:Aproid.Model"
    Title="Photos">

    <Grid x:Name="Root" Background="{ThemeResource AproidGlassBrush}" KeyDown="Root_KeyDown">
        <Grid.Resources>
            <CollectionViewSource x:Name="MonthsSource" IsSourceGrouped="True" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Padding="20,14,16,10" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Photos" Style="{StaticResource AproidTitle}" FontSize="20" />
                <TextBlock x:Name="Hint" Text="Double-click to view" Style="{StaticResource AproidCaption}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Style="{StaticResource AproidPlainButton}" Padding="8" Click="Refresh_Click" IsEnabled="{x:Bind Store.HasPhone, Mode=OneWay}" ToolTipService.ToolTip="Reload" AutomationProperties.Name="Reload">
                    <views:LucideIcon Icon="RotateCw" Size="15" Foreground="{ThemeResource AproidSubBrush}" />
                </Button>
                <Button Style="{StaticResource AproidPlainButton}" Padding="8" Click="OpenDownloads_Click" ToolTipService.ToolTip="Open Downloads" AutomationProperties.Name="Open Downloads">
                    <views:LucideIcon Icon="FolderOpen" Size="15" Foreground="{ThemeResource AproidSubBrush}" />
                </Button>
                <Button x:Name="DownloadButton" Style="{StaticResource AccentButtonStyle}" CornerRadius="10" Padding="14,7" Click="Download_Click" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <views:LucideIcon Icon="Download" Size="14" Foreground="{ThemeResource AproidOnAccentBrush}" />
                        <TextBlock x:Name="DownloadLabel" Text="Download" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- The gallery, newest first, by month -->
        <GridView x:Name="Gallery" Grid.Row="1" Padding="16,0,16,16" SelectionMode="Extended" IsItemClickEnabled="False"
                  SelectionChanged="Gallery_SelectionChanged" DoubleTapped="Gallery_DoubleTapped" ContainerContentChanging="Gallery_ContainerContentChanging">
            <GridView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="model:PhotoMonth">
                            <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AproidTextBrush}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </GridView.GroupStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="model:PhotoItem">
                    <Grid Width="132" Height="132" CornerRadius="8" Background="{ThemeResource AproidThumbBrush}" ToolTipService.ToolTip="{x:Bind Name}">
                        <views:LucideIcon Icon="Image" Size="22" Foreground="{ThemeResource AproidSubBrush}" />
                        <Image Source="{x:Bind views:PhotosWindow.Thumb(Thumbnail)}" Stretch="UniformToFill" />
                        <Border Visibility="{x:Bind IsVideo}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Padding="5,3" CornerRadius="6" Background="#99000000">
                            <views:LucideIcon Icon="Video" Size="12" Foreground="White" />
                        </Border>
                        <Border Visibility="{x:Bind IsDownloading, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Padding="5,3" CornerRadius="6" Background="#99000000">
                            <views:LucideIcon Icon="Download" Size="12" Foreground="White" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind Store.IsEmpty, Mode=OneWay}">
            <Border Width="64" Height="64" CornerRadius="32" Background="{ThemeResource AproidTintBrush}" HorizontalAlignment="Center">
                <views:LucideIcon Icon="Images" Size="28" Foreground="{ThemeResource AproidAccentBrush}" />
            </Border>
            <TextBlock Text="{x:Bind Store.EmptyText, Mode=OneWay}" Style="{StaticResource AproidBody}" TextAlignment="Center" />
            <ProgressRing IsActive="{x:Bind Store.IsLoading, Mode=OneWay}" Visibility="{x:Bind Store.IsLoading, Mode=OneWay}" Width="20" Height="20" />
        </StackPanel>

        <!-- The viewer -->
        <Grid Grid.RowSpan="2" Background="#F2101012" Visibility="{x:Bind Store.IsViewing, Mode=OneWay}" RequestedTheme="Dark">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Padding="16,12" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource AproidPlainButton}" Padding="8" Click="CloseViewer_Click" ToolTipService.ToolTip="Back to all photos (Esc)" AutomationProperties.Name="Close">
                    <views:LucideIcon Icon="X" Size="16" Foreground="White" />
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewedName(Store.Viewed), Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewedDate(Store.Viewed), Mode=OneWay}" FontSize="11" Foreground="#B3FFFFFF" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" CornerRadius="10" Padding="14,7" Click="DownloadViewed_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <views:LucideIcon Icon="Download" Size="14" Foreground="{ThemeResource AproidOnAccentBrush}" />
                        <TextBlock Text="Download" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Padding="16,0,16,16">
                <Image Source="{x:Bind Preview(Store.ViewedFile, Store.Viewed), Mode=OneWay}" Stretch="Uniform" />

                <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind Store.ViewedLoading, Mode=OneWay}">
                    <ProgressRing IsActive="{x:Bind Store.ViewedLoading, Mode=OneWay}" Width="28" Height="28" />
                    <TextBlock Text="Getting it from your phone…" FontSize="12" Foreground="#B3FFFFFF" />
                </StackPanel>

                <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind Store.ViewedFailed, Mode=OneWay}">
                    <TextBlock Text="Couldn't load this one" FontSize="13" Foreground="White" />
                    <Button Content="Try again" HorizontalAlignment="Center" CornerRadius="10" Click="Retry_Click" />
                </StackPanel>

                <Button HorizontalAlignment="Center" VerticalAlignment="Center" Width="64" Height="64" CornerRadius="32" Padding="0" Background="#99000000" BorderThickness="0"
                        Visibility="{x:Bind IsPlayableVideo(Store.ViewedFile, Store.Viewed), Mode=OneWay}" Click="PlayVideo_Click" ToolTipService.ToolTip="Play in your video app" AutomationProperties.Name="Play">
                    <views:LucideIcon Icon="Play" Size="26" Foreground="White" />
                </Button>

                <Button HorizontalAlignment="Left" VerticalAlignment="Center" Width="44" Height="44" CornerRadius="22" Padding="0" Background="#66000000" BorderThickness="0"
                        IsEnabled="{x:Bind Store.CanGoBack, Mode=OneWay}" Click="Previous_Click" ToolTipService.ToolTip="Previous (Left arrow)" AutomationProperties.Name="Previous">
                    <views:LucideIcon Icon="ChevronLeft" Size="20" Foreground="White" />
                </Button>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="44" Height="44" CornerRadius="22" Padding="0" Background="#66000000" BorderThickness="0"
                        IsEnabled="{x:Bind Store.CanGoForward, Mode=OneWay}" Click="Next_Click" ToolTipService.ToolTip="Next (Right arrow)" AutomationProperties.Name="Next">
                    <views:LucideIcon Icon="ChevronRight" Size="20" Foreground="White" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
